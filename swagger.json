ente o inválido."},"403":{"description":"Rol insuficiente. Se requiere administrador."},"422":{"description":"Datos de entrada inválidos (validación)."},"500":{"description":"Error interno del servidor."}},"security":[{"supabase-jwt":[]}],"summary":"Cambiar rol de un usuario","tags":["admin"]}},"/api/v1/admin/forum/{id}":{"delete":{"description":"Elimina un foro completo y todos sus comentarios en cascada. Solo accesible para administradores.","operationId":"AdminController_deleteForum","parameters":[{"name":"id","required":true,"in":"path","description":"UUID del foro","schema":{"type":"string"}}],"responses":{"200":{"description":"Foro y comentarios eliminados exitosamente."},"401":{"description":"Token ausente o inválido."},"403":{"description":"Rol insuficiente. Se requiere administrador."},"404":{"description":"Foro no encontrado."}},"security":[{"supabase-jwt":[]}],"summary":"Eliminar un foro","tags":["admin"]}},"/api/v1/admin/forum/comments/{id}":{"delete":{"description":"Elimina un comentario específico de un foro. Solo accesible para administradores.","operationId":"AdminController_deleteForumComment","parameters":[{"name":"id","required":true,"in":"path","description":"UUID del comentario","schema":{"type":"string"}}],"responses":{"200":{"description":"Comentario eliminado exitosamente."},"401":{"description":"Token ausente o inválido."},"403":{"description":"Rol insuficiente. Se requiere administrador."},"404":{"description":"Comentario no encontrado."}},"security":[{"supabase-jwt":[]}],"summary":"Eliminar un comentario del foro","tags":["admin"]}},"/api/v1/community/forums":{"get":{"operationId":"CommunityController_getForums","parameters":[],"responses":{"200":{"description":"Lista de foros retornada con éxito."}},"security":[{"supabase-jwt":[]}],"summary":"Obtener lista de foros activos","tags":["community"]}},"/api/v1/community/forums/{id}/comments":{"get":{"operationId":"CommunityController_getComments","parameters":[{"name":"id","required":true,"in"