# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Base de datos (Supabase como Postgres puro) ───────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars_different_from_access

# ── Email (Gmail SMTP con Contraseña de Aplicación — 100% Gratuito a cualquier correo) ─
GMAIL_USER=habitapp296@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Email (Resend — Respaldo opcional) ────────────────────────────────────────
# Plan gratuito: 3,000 emails/mes, 100/día
# Obtén tu key en: https://resend.com/api-keys
# En dev puedes usar 're_dummy_key_for_dev' (emails fallan silenciosamente)
RESEND_API_KEY=re_your_api_key
MAIL_FROM=habitapp296@gmail.com

# ── OAuth Google ──────────────────────────────────────────────────────────────
# Configura en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── OAuth Facebook ────────────────────────────────────────────────────────────
# Configura en: https://developers.facebook.com → Tu App → Facebook Login
FACEBOOK_APP_ID=1234567890
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/auth/facebook/callback

# ── OAuth Microsoft ───────────────────────────────────────────────────────────
# Configura en: https://portal.azure.com → Entra ID → App registrations
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=your_client_secret_value
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback

# ── Sentry (opcional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
